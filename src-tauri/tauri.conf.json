{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UkeGeeks Studio",
  "version": "0.1.0",
  "identifier": "org.ukegeeks.studio",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "npm run vendor",
    "beforeBuildCommand": "npm run vendor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UkeGeeks Studio",
        "width": 1200,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "worker-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Music",
    "publisher": "UkeGeeks",
    "copyright": "Copyright 2026 Buz Carter. GPL-3.0.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://ukegeeks.org",
    "shortDescription": "Make and play ukulele songbooks",
    "longDescription": "UkeGeeks Studio keeps your ChordPro songs in songbooks, shows them as songsheets with chord diagrams, and edits, prints and saves them.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
